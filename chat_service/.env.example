# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL (Chat Service dedicated DB) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=netrack_chat
DB_USER=chat_user
DB_PASSWORD=your_strong_password
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must match the JWT signing secret used by the main Netrack auth system
JWT_SECRET=netrack_super_secret_jwt_key_2024
JWT_EXPIRES_IN=7d
        
# ── Main Netrack System Bridge ────────────────────────────────────────────────
MAIN_API_BASE_URL=https://api.netrack.com
CHAT_SERVICE_KEY=dev_secret_key_2024

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# ── Redis (for caching and job queue) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── SMS Gateway (eMedia Uganda) ───────────────────────────────────────────────
SMS_USER=netrackdev
SMS_PASSWORD=Netrack@2026
SMS_SENDER_ID=Netrack

# ── ECareAfrica school database (read-only: user context, auth) ───────────────
ECAFRICA_DB_HOST=localhost
ECAFRICA_DB_PORT=5432
ECAFRICA_DB_NAME=ECareAfrica_db
ECAFRICA_DB_USER=postgres
ECAFRICA_DB_PASSWORD=1234
ECAFRICA_DB_SSL=false

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=10
